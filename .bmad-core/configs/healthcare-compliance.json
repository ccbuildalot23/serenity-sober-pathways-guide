{
  "name": "healthcare-compliance",
  "version": "1.0.0",
  "description": "BMAD Healthcare Compliance Configuration for Serenity Sober Pathways",
  "compliance": {
    "standards": ["HIPAA", "HITECH", "42 CFR Part 2", "SAMHSA"],
    "certifications": ["SOC2 Type II", "ISO 27001", "HITRUST"],
    "auditTrail": true,
    "encryptionAtRest": true,
    "encryptionInTransit": true,
    "minimumPasswordStrength": "strong",
    "sessionTimeout": 900,
    "dataRetention": {
      "patientRecords": 2555,
      "auditLogs": 2190,
      "sessionData": 90
    }
  },
  "phi_handling": {
    "classification": ["public", "internal", "confidential", "restricted"],
    "encryption": {
      "algorithm": "AES-256-GCM",
      "keyRotation": 90,
      "keyManagement": "AWS KMS"
    },
    "accessControl": {
      "mfa": true,
      "rbac": true,
      "needToKnow": true,
      "breakGlass": true
    },
    "dataMinimization": true,
    "purposeLimitation": true
  },
  "clinical_workflows": {
    "assessments": {
      "PHQ9": "depression",
      "GAD7": "anxiety",
      "AUDIT": "alcohol",
      "DAST10": "substance",
      "PCL5": "trauma"
    },
    "carePlans": {
      "evidenceBased": true,
      "personalized": true,
      "measurableGoals": true,
      "progressTracking": true
    },
    "crisis": {
      "protocols": ["safety_plan", "warm_handoff", "emergency_contact"],
      "escalation": ["peer", "counselor", "provider", "emergency"],
      "documentation": "required"
    }
  },
  "billing": {
    "cptCodes": {
      "90791": "Psychiatric Diagnostic Evaluation",
      "90834": "Individual Psychotherapy 45 min",
      "90837": "Individual Psychotherapy 60 min",
      "90853": "Group Psychotherapy",
      "99354": "Crisis Intervention",
      "H0001": "Alcohol/Drug Assessment",
      "H0004": "Behavioral Health Counseling",
      "H0005": "Alcohol/Drug Services Group",
      "H0015": "Intensive Outpatient Treatment"
    },
    "modifiers": {
      "GT": "Telehealth",
      "HO": "Masters Degree Level",
      "U5": "Medicaid",
      "HA": "Child/Adolescent"
    }
  },
  "quality_metrics": {
    "outcomes": {
      "phq9_reduction": 0.5,
      "gad7_reduction": 0.5,
      "retention_30day": 0.8,
      "retention_90day": 0.6,
      "crisis_prevention": 0.9
    },
    "process": {
      "assessment_completion": 0.95,
      "care_plan_update": 0.9,
      "followup_adherence": 0.85
    },
    "satisfaction": {
      "patient_nps": 40,
      "provider_satisfaction": 0.8,
      "supporter_engagement": 0.7
    }
  },
  "integrations": {
    "ehr": ["Epic", "Cerner", "Athena"],
    "pharmacy": ["Surescripts", "CVS", "Walgreens"],
    "labs": ["Quest", "LabCorp"],
    "insurance": ["BCBS", "United", "Aetna", "Medicaid"],
    "telehealth": ["Zoom Healthcare", "Doxy.me", "Daily.co"]
  },
  "agents": {
    "clinical": [
      "intake-specialist",
      "care-coordinator",
      "crisis-responder",
      "billing-specialist",
      "compliance-auditor"
    ],
    "technical": [
      "phi-guardian",
      "audit-logger",
      "encryption-manager",
      "access-controller",
      "incident-responder"
    ],
    "operational": [
      "quality-analyst",
      "outcome-tracker",
      "report-generator",
      "training-coordinator",
      "credentialing-manager"
    ]
  },
  "automations": {
    "patientOnboarding": {
      "steps": ["consent", "insurance_verify", "assessment", "care_match"],
      "sla": 24
    },
    "dailyCheckIn": {
      "frequency": "daily",
      "reminders": true,
      "escalation": true
    },
    "crisisProtocol": {
      "detection": ["keywords", "scores", "patterns"],
      "response": ["immediate", "tiered", "documented"],
      "followup": "required"
    },
    "billing": {
      "autoSubmit": true,
      "priorAuth": true,
      "denialManagement": true
    }
  },
  "reporting": {
    "regulatory": {
      "frequency": "quarterly",
      "formats": ["CMS", "NCQA", "State"],
      "automated": true
    },
    "clinical": {
      "dashboards": ["provider", "admin", "quality"],
      "realtime": true,
      "predictive": true
    },
    "financial": {
      "revenue_cycle": true,
      "utilization": true,
      "forecasting": true
    }
  }
}