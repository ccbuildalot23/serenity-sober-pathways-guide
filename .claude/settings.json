{
  "env": {
    "BMAD_AUTO_COMMIT": "false",
    "BMAD_AUTO_PUSH": "false",
    "BMAD_HOOKS_ENABLED": "true",
    "BMAD_TELEMETRY_ENABLED": "true",
    "BMAD_HEALTHCARE_MODE": "true",
    "BMAD_HIPAA_COMPLIANCE": "true",
    "BMAD_PHI_PROTECTION": "true"
  },
  "permissions": {
    "allow": [
      "Bash(node .bmad-core/bmad.js *)",
      "Bash(npm run bmad:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git config *)",
      "Bash(git tag *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(jq *)",
      "Bash(node *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(eval *)"
    ]
  },
  "hooks": {
    "PreToolUse": [],
    "PostToolUse": [],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'PreCompact: Preserving agent context and swarm configurations from CLAUDE.md'"
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Auto-Compact: Maintaining agent strategies and concurrent execution patterns'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .bmad-core/bmad.js session-end --generate-summary true --persist-state true --export-metrics true"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": true,
  "enabledMcpjsonServers": []
}
