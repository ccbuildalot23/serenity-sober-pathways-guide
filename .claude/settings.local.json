{
  "permissions": {
    "allow": [
      "Read(//c/c/dev/**)",
      "Read(//c/dev/serenity-aws/**)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "C:\\dev\\serenity-aws",
      "C:\\Users\\cmcal\\OneDrive\\Documents",
      "C:\\ios-certs"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "plan|research|analyze|architect|security|test|performance|fix",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Plan mode detected. Initializing appropriate agents.'",
            "timeout": 1000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Session started. Configuration optimized for stability.'",
            "timeout": 500
          }
        ]
      }
    ]
  }
}