# Serenity Environment Configuration Template
# Copy this file to .env.dev, .env.test, or .env.prod and fill in your values

# ===================
# ENVIRONMENT SETTINGS
# ===================
NODE_ENV=development
ENVIRONMENT=development
VERSION=latest

# ===================
# DATABASE CONFIGURATION
# ===================

# PostgreSQL
POSTGRES_DB=serenity_dev
POSTGRES_USER=serenity_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://serenity_user:change_me_in_production@postgres:5432/serenity_dev

# Redis
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@redis:6379

# MongoDB
MONGODB_USERNAME=admin
MONGODB_PASSWORD=change_me_in_production
MONGODB_URL=mongodb://admin:change_me_in_production@mongodb:27017/serenity_notifications?authSource=admin

# ===================
# MESSAGE QUEUE
# ===================
RABBITMQ_DEFAULT_USER=serenity
RABBITMQ_DEFAULT_PASS=change_me_in_production
RABBITMQ_URL=amqp://serenity:change_me_in_production@rabbitmq:5672

# ===================
# EXTERNAL SERVICES
# ===================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration - Generate secure keys with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production-64-chars-minimum
JWT_REFRESH_SECRET=your-super-secure-jwt-refresh-secret-key-change-in-production-64-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=serenity-platform
JWT_AUDIENCE=serenity-users

# ===================
# NOTIFICATION SERVICES
# ===================

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key

# Firebase Push Notifications
FIREBASE_PROJECT_ID=your-firebase-project-id

# ===================
# SMTP CONFIGURATION
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ===================
# MONITORING & LOGGING
# ===================
GRAFANA_ADMIN_PASSWORD=change_me_in_production
GRAFANA_DB_PASSWORD=change_me_in_production

# ===================
# SECURITY SETTINGS & HIPAA COMPLIANCE
# ===================
CORS_ORIGINS=http://localhost:8080,https://app.serenity.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption Keys - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-encryption-key-in-hex-format-64-chars-total-required
PHI_ENCRYPTION_KEY=your-32-byte-phi-encryption-key-in-hex-format-64-chars-required
VITE_ENCRYPTION_MASTER_KEY=your-32-byte-master-encryption-key-in-hex-64-chars
EMERGENCY_OVERRIDE_KEY=your-32-byte-emergency-override-key-in-hex-64-chars

# HIPAA Compliance Settings
HIPAA_ENCRYPTION_REQUIRED=true
SESSION_TIMEOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=3
PASSWORD_MIN_LENGTH=12
AUDIT_RETENTION_YEARS=6
ENABLE_AUDIT_LOGGING=true

# AWS Configuration (Production)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-aws-account-id
KMS_KEY_ID=your-kms-key-id
CLOUDWATCH_LOG_GROUP=/aws/lambda/serenity
SNS_CRISIS_TOPIC_ARN=your-sns-topic-arn
AUDIT_TABLE_NAME=hipaa-audit-logs

# External Service API Keys
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VOICE_ANALYSIS_API_KEY=your-voice-analysis-api-key
NOTIFICATION_SERVICE_API_KEY=your-notification-service-api-key
EMERGENCY_SERVICE_API_KEY=your-emergency-service-api-key

# Feature Flags
ENABLE_CRISIS_DETECTION=true
ENABLE_COST_MONITORING=true
ENABLE_PERFORMANCE_MONITORING=true
MOCK_EXTERNAL_SERVICES=false
ENABLE_DEBUG_LOGGING=false

# Monitoring
SENTRY_DSN=your-sentry-dsn

# PRODUCTION SECURITY NOTES:
# 1. Never commit real production keys to version control
# 2. Use environment variable injection in production deployments  
# 3. Rotate keys regularly (minimum every 90 days)
# 4. Use AWS KMS or similar key management service in production
# 5. Ensure all encryption keys are at least 256 bits (32 bytes)
# 6. Enable audit logging in production