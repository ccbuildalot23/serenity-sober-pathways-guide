# Serenity Environment Configuration Template
# Copy this file to .env.dev, .env.test, or .env.prod and fill in your values

# ===================
# ENVIRONMENT SETTINGS
# ===================
NODE_ENV=development
ENVIRONMENT=development
VERSION=latest

# ===================
# DATABASE CONFIGURATION
# ===================

# PostgreSQL
POSTGRES_DB=serenity_dev
POSTGRES_USER=serenity_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://serenity_user:change_me_in_production@postgres:5432/serenity_dev

# Redis
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@redis:6379

# MongoDB
MONGODB_USERNAME=admin
MONGODB_PASSWORD=change_me_in_production
MONGODB_URL=mongodb://admin:change_me_in_production@mongodb:27017/serenity_notifications?authSource=admin

# ===================
# MESSAGE QUEUE
# ===================
RABBITMQ_DEFAULT_USER=serenity
RABBITMQ_DEFAULT_PASS=change_me_in_production
RABBITMQ_URL=amqp://serenity:change_me_in_production@rabbitmq:5672

# ===================
# EXTERNAL SERVICES
# ===================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production

# ===================
# NOTIFICATION SERVICES
# ===================

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key

# Firebase Push Notifications
FIREBASE_PROJECT_ID=your-firebase-project-id

# ===================
# SMTP CONFIGURATION
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ===================
# MONITORING & LOGGING
# ===================
GRAFANA_ADMIN_PASSWORD=change_me_in_production
GRAFANA_DB_PASSWORD=change_me_in_production

# ===================
# SECURITY SETTINGS
# ===================
CORS_ORIGINS=http://localhost:8080,https://app.serenity.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100