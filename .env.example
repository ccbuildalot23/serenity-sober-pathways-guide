SUPABASE_URL=
# The base URL of your Supabase project, e.g., https://xyzcompany.supabase.co

SUPABASE_ANON_KEY=
# Public anon key for client-side operations. Do not use for privileged seeds.

SUPABASE_SERVICE_ROLE_KEY=
# Service role key with elevated privileges. Required for seeding. Keep private.

# MCP Server Configuration
VITE_MCP_SERVER_URL=
# The base URL of your MCP server, e.g., http://localhost:3000

# Optional: External Service Integrations
VITE_TWILIO_ACCOUNT_SID=
# Twilio account SID for SMS notifications

VITE_TWILIO_AUTH_TOKEN=
# Twilio auth token for SMS notifications

VITE_SENDGRID_API_KEY=
# SendGrid API key for email notifications

VITE_FCM_SERVER_KEY=
# Firebase Cloud Messaging server key for push notifications
