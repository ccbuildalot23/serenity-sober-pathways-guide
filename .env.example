SUPABASE_URL=
# The base URL of your Supabase project, e.g., https://xyzcompany.supabase.co

SUPABASE_ANON_KEY=
# Public anon key for client-side operations. Do not use for privileged seeds.

SUPABASE_SERVICE_ROLE_KEY=
# Service role key with elevated privileges. Required for seeding. Keep private.

# Logging Configuration
VITE_ENABLE_CONSOLE_LOGGING=true
# Set to false in production to disable console logging. Default: true in development, false in production

VITE_LOG_LEVEL=debug
# Logging level: debug, info, warn, error, security. Default: debug in development, error in production

VITE_ENABLE_PERFORMANCE_LOGGING=false
# Enable performance logging for API calls and database operations. Default: false

# AWS Agent Configuration
AWS_REGION=us-east-1
# AWS region for agent deployment

SAGEMAKER_ENDPOINT=
# SageMaker endpoint for ML predictions (optional)

PERSONALIZE_CAMPAIGN_ARN=
# Amazon Personalize campaign for recommendations (optional)

PERSONALIZE_TRACKING_ID=
# Amazon Personalize tracking ID for event collection (optional)

PERSONALIZE_DATASET_ARN=
# Amazon Personalize dataset ARN (optional)

GUARDDUTY_DETECTOR_ID=
# GuardDuty detector ID for threat detection (optional)

CRISIS_STATE_MACHINE_ARN=
# Step Functions state machine for crisis orchestration

CRISIS_SNS_TOPIC_ARN=
# SNS topic for crisis alerts

CONNECT_INSTANCE_ID=
# Amazon Connect instance for voice calls (optional)

CRISIS_CONTACT_FLOW_ID=
# Amazon Connect contact flow for crisis calls

CRISIS_PHONE_NUMBER=
# Phone number for outbound crisis calls

PINPOINT_APP_ID=
# Amazon Pinpoint application for SMS/push notifications

CRISIS_SMS_NUMBER=
# SMS origination number for crisis messages

COMPLIANCE_SNS_TOPIC_ARN=
# SNS topic for compliance alerts

COST_ALERTS_SNS_TOPIC_ARN=
# SNS topic for cost optimization alerts

WELLBEING_ALERTS_TOPIC_ARN=
# SNS topic for provider wellbeing alerts
