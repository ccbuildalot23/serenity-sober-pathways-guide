# Performance optimizations for Windows terminal
max-old-space-size=4096
legacy-peer-deps=true
production=false
fund=false
audit=false
progress=false
prefer-offline=true
cache-min=3600
fetch-retries=2
fetch-retry-factor=10
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Platform-specific settings (commented out for Vercel compatibility)
# script-shell=powershell.exe
# msvs-version=2022

# Don't skip optional dependencies (needed for rollup)

# Reduce terminal output
loglevel=error