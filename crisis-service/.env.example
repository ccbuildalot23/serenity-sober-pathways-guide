# Crisis Service Environment Configuration
# HIPAA-compliant configuration for crisis management system
# Copy this file to .env and fill in the actual values

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
NODE_ENV=development
CRISIS_SERVICE_PORT=3002
BASE_URL=http://localhost:3002

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/crisis_service_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT=30000

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Redis connection for caching and pub/sub
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_RETRY_DELAY=1000

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# Use a strong 32+ character secret in production
JWT_SECRET=your_extremely_secure_jwt_secret_key_here_32chars_minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# ENCRYPTION KEYS (HIPAA COMPLIANCE)
# ==============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_encryption_key_for_hipaa_compliance_data
ENCRYPTION_IV_LENGTH=16

# ==============================================================================
# EMERGENCY SERVICES CONFIGURATION
# ==============================================================================
# Emergency override key for bypassing rate limits during crisis
EMERGENCY_OVERRIDE_KEY=your_emergency_override_key_32chars_minimum_security

# Emergency service API integration
EMERGENCY_SERVICE_API_KEY=your_emergency_service_api_key

# 911 Integration (if available in your jurisdiction)
EMERGENCY_911_ENDPOINT=https://api.emergency-services.gov/911
MENTAL_HEALTH_API_ENDPOINT=https://api.mental-health-services.org/crisis
MENTAL_HEALTH_API_KEY=your_mental_health_api_key

# ==============================================================================
# TWILIO CONFIGURATION (SMS/VOICE)
# ==============================================================================
# Get these from your Twilio console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# LOCATION SERVICES
# ==============================================================================
# Google Maps API key for location services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GEOFENCE_RADIUS_METERS=500

# ==============================================================================
# MACHINE LEARNING CONFIGURATION
# ==============================================================================
ML_MODEL_PATH=./models/crisis-prediction
ML_BATCH_SIZE=32
ML_CONFIDENCE_THRESHOLD=0.8

# ==============================================================================
# WEBSOCKET CONFIGURATION
# ==============================================================================
WEBSOCKET_HEARTBEAT_INTERVAL=25000
WEBSOCKET_TIMEOUT=60000

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
LOG_LEVEL=info
LOG_MAX_FILES=5
LOG_MAX_SIZE=20m

# ==============================================================================
# PERFORMANCE MONITORING
# ==============================================================================
RESPONSE_TIME_THRESHOLD_MS=500
CRISIS_RESPONSE_MAX_TIME_MS=500

# ==============================================================================
# EXTERNAL SERVICES
# ==============================================================================
# Notification service integration
NOTIFICATION_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_API_KEY=your_notification_service_api_key

# Voice analysis service
VOICE_ANALYSIS_API_KEY=your_voice_analysis_api_key
VOICE_ANALYSIS_ENDPOINT=https://api.voice-analysis.com/v1/analyze

# ==============================================================================
# BIOMETRIC MONITORING THRESHOLDS
# ==============================================================================
BIOMETRIC_THRESHOLD_HEART_RATE_HIGH=120
BIOMETRIC_THRESHOLD_HEART_RATE_LOW=50
BIOMETRIC_SLEEP_HOURS_MIN=4

# ==============================================================================
# CRISIS ESCALATION TIMING
# ==============================================================================
# Delays in milliseconds
ESCALATION_TIER1_DELAY_MS=30000
ESCALATION_TIER2_DELAY_MS=180000
ESCALATION_PROFESSIONAL_DELAY_MS=300000

# ==============================================================================
# SAFETY CHECK-IN CONFIGURATION
# ==============================================================================
SAFETY_CHECKIN_INTERVAL_HOURS=24
SAFETY_CHECKIN_REMINDER_HOURS=2

# ==============================================================================
# DATA RETENTION (HIPAA COMPLIANCE)
# ==============================================================================
# Retention periods in days
DATA_RETENTION_DAYS=2555
AUDIT_LOG_RETENTION_DAYS=2555
SESSION_TIMEOUT_MINUTES=15
