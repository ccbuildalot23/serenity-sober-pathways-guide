# Serenity Database Environment Configuration
# Copy this file to .env and update with your actual values
# ⚠️  NEVER commit actual credentials to version control

# =================================================================
# DATABASE CONNECTION
# =================================================================

# Primary database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=serenity_dev
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# SSL Configuration (required for production)
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=path/to/ca-certificate.crt
DB_SSL_KEY=path/to/client-key.key
DB_SSL_CERT=path/to/client-certificate.crt

# Connection pool settings (optional - defaults provided)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_ACQUIRE_TIMEOUT=30000
DB_CREATE_TIMEOUT=30000
DB_IDLE_TIMEOUT=30000

# Enable query debugging (development only)
DB_DEBUG=false

# =================================================================
# HIPAA COMPLIANCE & ENCRYPTION
# =================================================================

# Encryption key for PHI data (REQUIRED - minimum 32 characters)
# Generate with: openssl rand -hex 32
DB_ENCRYPTION_KEY=your_32_character_encryption_key_for_phi_data_security_2023

# Application context for audit logging
APP_NAME=Serenity
APP_VERSION=1.0.0

# =================================================================
# BACKUP CONFIGURATION
# =================================================================

# Local backup directory (ensure it's secure and encrypted)
BACKUP_DIR=/secure/backups/serenity
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_different_from_db_key
BACKUP_RETENTION_DAYS=30

# S3 backup configuration (for secure cloud backups)
BACKUP_S3_BUCKET=your-hipaa-compliant-s3-bucket
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# =================================================================
# ENVIRONMENT SPECIFIC
# =================================================================

NODE_ENV=development

# Development settings
DEV_AUTO_MIGRATE=true
DEV_SEED_DATA=true
DEV_SKIP_SSL=true

# Staging settings (uncomment for staging)
# NODE_ENV=staging
# DEV_AUTO_MIGRATE=false
# DEV_SEED_DATA=false

# Production settings (uncomment for production)
# NODE_ENV=production
# DEV_AUTO_MIGRATE=false
# DEV_SEED_DATA=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# =================================================================
# MONITORING & LOGGING
# =================================================================

# Database monitoring
DB_MONITOR_CONNECTIONS=true
DB_MONITOR_SLOW_QUERIES=true
DB_SLOW_QUERY_THRESHOLD=1000

# Audit logging levels
AUDIT_LOG_LEVEL=info
AUDIT_LOG_PHI_ACCESS=true
AUDIT_LOG_FAILED_LOGINS=true

# =================================================================
# SECURITY SETTINGS
# =================================================================

# Session security
SESSION_TIMEOUT_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# PHI access controls
PHI_ACCESS_LOG_REQUIRED=true
PHI_SESSION_TIMEOUT_MINUTES=15
REQUIRE_MFA_FOR_PHI=false

# =================================================================
# EXTERNAL INTEGRATIONS
# =================================================================

# Crisis management integrations (if applicable)
CRISIS_WEBHOOK_URL=https://your-crisis-system.com/webhook
CRISIS_API_KEY=your_crisis_system_api_key

# Notification service configuration
NOTIFICATION_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Email service (for notifications)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key

# =================================================================
# DEVELOPMENT TESTING
# =================================================================

# Test database (separate from main database)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=serenity_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=test_password

# Testing encryption key (NEVER use in production)
TEST_ENCRYPTION_KEY=test_key_for_development_only_32_chars

# =================================================================
# PERFORMANCE TUNING
# =================================================================

# Query optimization
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Materialized view refresh frequency (minutes)
MATERIALIZED_VIEW_REFRESH_FREQUENCY=60

# Analytics and reporting
ANALYTICS_BATCH_SIZE=1000
ANALYTICS_RETENTION_DAYS=365

# =================================================================
# COMPLIANCE & AUDIT
# =================================================================

# HIPAA compliance settings
HIPAA_AUDIT_ENABLED=true
HIPAA_AUDIT_RETENTION_YEARS=7
HIPAA_BREACH_NOTIFICATION_EMAIL=security@yourorganization.com

# Compliance reporting
COMPLIANCE_REPORT_FREQUENCY=weekly
COMPLIANCE_REPORT_EMAIL=compliance@yourorganization.com

# Data retention policies
AUDIT_LOG_RETENTION_YEARS=7
SESSION_LOG_RETENTION_DAYS=90
BACKUP_RETENTION_YEARS=7

# =================================================================
# EXAMPLE VALUES FOR DIFFERENT ENVIRONMENTS
# =================================================================

# DEVELOPMENT EXAMPLE:
# DB_HOST=localhost
# DB_NAME=serenity_dev
# DB_ENCRYPTION_KEY=dev_key_32_chars_for_testing_only_2023
# NODE_ENV=development
# DEV_SEED_DATA=true

# STAGING EXAMPLE:
# DB_HOST=staging-db.yourorganization.com
# DB_NAME=serenity_staging
# DB_ENCRYPTION_KEY=staging_encryption_key_32_characters_long_2023
# NODE_ENV=staging
# DB_SSL_REJECT_UNAUTHORIZED=true

# PRODUCTION EXAMPLE:
# DB_HOST=prod-db.yourorganization.com
# DB_NAME=serenity_production
# DB_ENCRYPTION_KEY=prod_encryption_key_from_secure_key_management_2023
# NODE_ENV=production
# DB_SSL_REJECT_UNAUTHORIZED=true
# HIPAA_AUDIT_ENABLED=true
# PHI_ACCESS_LOG_REQUIRED=true

# =================================================================
# SECURITY NOTES
# =================================================================

# 🔐 ENCRYPTION KEYS:
#   - Use different keys for each environment
#   - Store production keys in secure key management (AWS KMS, HashiCorp Vault)
#   - Rotate encryption keys regularly (quarterly recommended)
#   - Never store keys in code or configuration files

# 🛡️  DATABASE SECURITY:
#   - Use strong, unique passwords for each environment
#   - Enable SSL/TLS for all database connections in production
#   - Implement IP whitelisting for database access
#   - Regular security audits and vulnerability assessments

# 📊 BACKUP SECURITY:
#   - Encrypt all backups with strong encryption
#   - Store backups in HIPAA-compliant storage (AWS S3 with encryption)
#   - Test backup restoration procedures regularly
#   - Implement cross-region backup replication for disaster recovery

# 🔍 MONITORING:
#   - Monitor all PHI access attempts
#   - Set up alerts for failed login attempts
#   - Track database performance and connection pool usage
#   - Log all administrative actions for audit purposes