# Example environment configuration for Serenity Sober Pathways iOS
# Copy this file to .env and fill in your actual values

# Apple ID and Team Configuration
APPLE_ID="your-apple-id@example.com"
TEAM_ID="XDY458RQ59"
ITC_TEAM_ID="XDY458RQ59"

# Match (Certificate Management)
# Generate a strong password for encrypting certificates in git repo
MATCH_PASSWORD="your-secure-match-password-here"
MATCH_KEYCHAIN_PASSWORD="your-keychain-password-here"

# Git credentials for certificate repository (base64 encoded username:token)
MATCH_GIT_BASIC_AUTHORIZATION="dXNlcm5hbWU6cGVyc29uYWxfYWNjZXNzX3Rva2Vu"

# App Store Connect API (Recommended for CI/CD)
# Get these from App Store Connect > Users and Access > Integrations
APP_STORE_CONNECT_API_KEY_ID="your-api-key-id"
APP_STORE_CONNECT_ISSUER_ID="your-issuer-id"
APP_STORE_CONNECT_API_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\nyour-private-key-content\n-----END PRIVATE KEY-----"

# Optional: Slack Notifications
SLACK_URL="https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"

# Optional: Custom certificate repository
MATCH_GIT_URL="https://github.com/serenity-recovery/ios-certificates"

# CI/CD Configuration
CI="false"  # Set to "true" in CI environments

# App Configuration
APP_NAME="Serenity Sober Pathways"
APP_IDENTIFIER="com.serenity.recovery"
SCHEME="App"

# Healthcare-specific configurations
HEALTHCARE_CATEGORY="MEDICAL"
CONTENT_RATING_MEDICAL="2"
CONTENT_RATING_ALCOHOL_DRUGS="2"

# Demo account for App Store review
DEMO_EMAIL="demo@serenity-recovery.app"
DEMO_PASSWORD="DemoPass2025!"

# Support contact information
SUPPORT_EMAIL="support@serenity-recovery.app"
SUPPORT_PHONE="+1-555-0123"

# URLs for App Store listing
MARKETING_URL="https://serenity-recovery.vercel.app"
PRIVACY_URL="https://serenity-recovery.vercel.app/privacy"
SUPPORT_URL="https://serenity-recovery.vercel.app/support"