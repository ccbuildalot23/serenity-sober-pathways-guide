# App Store Connect Configuration
app_identifier("com.serenity.recovery")
username("{{APPLE_ID}}")
team_id("XDY458RQ59")

# App Metadata
app_version("1.0.0")
copyright("© 2025 Serenity Recovery Solutions. All rights reserved.")

# Pricing and availability
price_tier(0) # Free app

# App categories - Healthcare/Medical primary, Health & Fitness secondary
primary_category("MEDICAL")
secondary_category("HEALTH_AND_FITNESS")

# App rating and content
content_rights_has_rights(true)
content_rights_contains_third_party_content(false)

# Age rating - 17+ for healthcare/medical content
app_rating_config_path("./metadata/rating_config.json")

# Submission information for healthcare apps
submission_information({
  add_id_info_limits_tracking: true,
  add_id_info_serves_ads: false,
  add_id_info_tracks_action: false,
  add_id_info_tracks_install: true,
  add_id_info_uses_idfa: false,
  content_rights_has_rights: true,
  content_rights_contains_third_party_content: false,
  export_compliance_platform: "ios",
  export_compliance_compliance_required: false,
  export_compliance_encryption_updated: false,
  export_compliance_uses_encryption: false,
  export_compliance_is_exempt: true,
  export_compliance_contains_third_party_cryptography: false,
  export_compliance_contains_proprietary_cryptography: false,
  export_compliance_available_on_french_store: false
})

# Automatic release configuration
automatic_release(false)
submit_for_review(false)

# Phased release
phased_release(true)

# Skip upload options - useful for testing
skip_binary_upload(false)
skip_screenshots(false)
skip_metadata(false)

# Force overwrite existing metadata
force(true)

# Run precheck before submission
run_precheck_before_submit(true)
precheck_include_in_app_purchases(false)

# Platform specification
platform("ios")

# Language support
languages(["en-US"])

