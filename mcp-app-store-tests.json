{
  "name": "Serenity App Store Preparation Tests",
  "version": "1.0.0",
  "tests": {
    "legal_documents": {
      "privacy_policy": {
        "url": "/privacy",
        "required_sections": [
          "HIPAA Compliance",
          "Mobile App Permissions",
          "California Privacy Rights",
          "Analytics and Crash Reporting"
        ],
        "validate_links": true,
        "check_mobile_responsive": true
      },
      "terms_of_service": {
        "url": "/terms",
        "required_sections": [
          "Medical Disclaimer",
          "Mobile App Terms",
          "In-App Purchases and Subscriptions",
          "Dispute Resolution"
        ],
        "validate_links": true,
        "check_mobile_responsive": true
      }
    },
    "screenshots": {
      "required_screens": [
        {
          "name": "crisis_support",
