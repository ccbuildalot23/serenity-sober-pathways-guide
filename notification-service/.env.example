# Application Configuration
APP_NAME=Serenity Notification Service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
MONGODB_URL=mongodb://localhost:27017/serenity_notifications
MONGODB_DATABASE=serenity_notifications

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@serenity.com
SENDGRID_FROM_NAME=Serenity Support

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key
FCM_SENDER_ID=your_fcm_sender_id

# Rate Limiting
RATE_LIMIT_SMS_PER_MINUTE=5
RATE_LIMIT_EMAIL_PER_MINUTE=10
RATE_LIMIT_PUSH_PER_MINUTE=20
RATE_LIMIT_WHATSAPP_PER_MINUTE=3

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_CORS_ORIGINS=*

# Monitoring and Logging
SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

# HIPAA Compliance
AUDIT_LOGGING_ENABLED=true
MESSAGE_RETENTION_DAYS=2555  # 7 years
PHI_ENCRYPTION_ENABLED=true

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2
RETRY_MAX_DELAY=300

# Health Check
HEALTH_CHECK_INTERVAL=30