{
  "name": "serenity-sober-pathways-guide",
  "version": "1.0.0",
  "description": "HIPAA-compliant mental health and substance abuse recovery platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:with-serena": "concurrently \"npm run serena:start\" \"npm run dev\"",
    "serena:start": "cd ../serena && uv run serena-mcp-server",
    "serena:index": "cd ../serena && uv run index-project",
    "build": "npm run fix:tokens && vite build && npm run validate:css",
    "validate:css": "node scripts/validate-css-build.js",
    "type-check": "tsc --noEmit",
    "vercel-build": "npm ci --legacy-peer-deps --no-audit --no-fund && npm run build",
    "fix:tokens": "node scripts/fix-tokens.cjs",
    "preview": "vite preview --port 8080 --host",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 1000",
    "lint:fix": "eslint . --fix --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "test:jest": "jest --runInBand",
    "test:pw": "playwright test",
    "test": "pnpm test:jest && pnpm test:pw",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:all": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "npx playwright test tests/e2e/",
    "test:e2e:mvp": "npx playwright test --config=playwright.config.mvp.ts",
    "test:e2e:headed": "npx playwright test tests/e2e/ --headed",
    "test:e2e:debug": "npx playwright test tests/e2e/ --debug",
    "test:patient": "npx playwright test tests/e2e/patient-journey.spec.ts",
    "test:provider": "npx playwright test tests/e2e/provider-journey.spec.ts",
    "test:supporter": "npx playwright test tests/e2e/supporter-journey.spec.ts",
    "test:crisis": "npx playwright test tests/e2e/crisis-support.spec.ts",
    "test:realtime": "npx playwright test tests/e2e/realtime-communication.spec.ts",
    "test:accessibility": "npx playwright test tests/accessibility/",
    "test:recovery": "npx playwright test tests/accessibility/recovery-features.spec.ts",
    "test:comprehensive": "npx playwright test tests/e2e/ --reporter=html",
    "test:performance": "npx playwright test tests/e2e/ --grep='performance'",
    "test:mobile": "npx playwright test tests/e2e/ --project='Mobile Chrome'",
    "test:notifications": "npx playwright test tests/e2e/notifications/",
    "test:notifications:multi-channel": "npx playwright test tests/e2e/notifications/multi-channel-delivery.spec.ts",
    "test:notifications:whatsapp": "npx playwright test tests/e2e/notifications/whatsapp-opt-in-flow.spec.ts",
    "test:notifications:rate-limiting": "npx playwright test tests/e2e/notifications/rate-limiting-quiet-hours.spec.ts",
    "test:notifications:crisis": "npx playwright test tests/e2e/notifications/crisis-alert-escalation.spec.ts",
    "test:notifications:unit": "jest services/notification-service/tests/unit/",
    "test:notifications:integration": "jest tests/integration/notifications/",
    "test:notifications:performance": "npx playwright test tests/performance/notification-load-test.spec.ts --workers=1",
    "test:notifications:security": "npx playwright test tests/security/hipaa-compliance.spec.ts",
    "test:security": "npx playwright test tests/security/",
    "test:security:hipaa": "npx playwright test tests/security/hipaa-compliance.spec.ts",
    "test:performance:load": "npx playwright test tests/performance/notification-load-test.spec.ts",
    "validate:structure": "node scripts/validate-structure.cjs",
    "fix:deployment": "node scripts/fix-deployment.cjs",
    "prebuild": "npm run validate:structure",
    "deployment:check": "node scripts/deployment-check.js",
    "test:storage": "node scripts/test-storage.js",
    "setup:deploy": "node scripts/setup-deploy.js",
    "deploy:vercel": "vercel",
    "deploy:netlify": "netlify deploy",
    "lighthouse:validate": "node scripts/lighthouse-validate.js",
    "lighthouse:test": "node scripts/lighthouse-validate.js --test",
    "lighthouse:local": "node scripts/lighthouse-validate.js --test --url http://localhost:5173",
    "prepare": "husky",
    "verify-production": "node scripts/productionVerification.js",
    "validate:hipaa": "node scripts/security-dependency-scan.js && npx playwright test tests/e2e/hipaa-compliance.spec.ts",
    "validate:auto": "node scripts/autonomous-validator.mjs",
    "validate:cloudtrail": "tsx scripts/validate-cloudtrail-hipaa.ts",
    "dev:seed": "tsx -r dotenv/config scripts/seed-demo-billing.ts",
    "smoke:csv": "tsx -r dotenv/config scripts/smoke-csv.ts",
    "activate:advanced": "tsx scripts/activate-advanced-features.ts",
    "swarm:init": "npx ruv-swarm init",
    "swarm:status": "npx ruv-swarm status",
    "security:byzantine": "tsx infrastructure/security/byzantine-security-manager.ts",
    "crisis:test": "tsx infrastructure/swarms/crisis-response-swarm.ts",
    "hipaa:scan": "gh workflow run hipaa-compliance-automation.yml",
    "production:validate": "npm run activate:advanced && npm run test:e2e && npm run validate:hipaa",
    "validate:mobile": "bash scripts/agent-validate-mobile.sh",
    "validate:mobile:agent": "npx claude-flow spawn mobile-validator --script scripts/agent-validate-mobile.sh",
    "validate:ios": "node scripts/ios-deployment-validator.js",
    "hipaa:validate": "tsx scripts/hipaa-validation-suite.ts",
    "build:mobile": "npm run build && npm run validate:css && npx cap sync",
    "deploy:testflight": "npm run build:mobile && cd ios/App && xcodebuild archive",
    "deploy:playstore": "npm run build:mobile && cd android && ./gradlew bundleRelease",
    "mobile:android": "gh workflow run android-deploy.yml",
    "mobile:ios": "gh workflow run ios-deploy.yml",
    "claude-flow:init": "node scripts/init-claude-flow.js",
    "claude-flow:status": "node scripts/claude-flow-status.js",
    "claude-flow:spawn": "node scripts/claude-flow-spawn.js",
    "claude-flow:validate": "node scripts/validate-claude-flow.js",
    "claude-flow:clean": "rm -rf memory/sessions/* && echo '{}' > memory/claude-flow-data.json",
    "bmad:init": "npx bmad-method@latest install",
    "bmad:agent": "node .bmad-core/bmad.js agent",
    "bmad:status": "npm run claude-flow:status",
    "bmad:analyze": "node .bmad-core/bmad.js analyze",
    "bmad:deploy": "node .bmad-core/bmad.js deploy",
    "bmad:test": "node .bmad-core/bmad.js test",
    "bmad:security": "node .bmad-core/bmad.js agent security-specialist",
    "bmad:devops": "node .bmad-core/bmad.js agent devops-engineer",
    "bmad:mobile": "node .bmad-core/bmad.js agent mobile-developer"
  },
