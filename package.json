{
  "name": "serenity-sober-pathways-guide",
  "version": "1.0.0",
  "description": "HIPAA-compliant mental health and substance abuse recovery platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run fix:tokens && tsc && vite build",
    "fix:tokens": "node scripts/fix-tokens.cjs",
    "preview": "vite preview --port 8080 --host",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 1000",
    "lint:fix": "eslint . --fix --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "test": "npx playwright test",
    "test:e2e": "npx playwright test tests/e2e/",
    "test:e2e:mvp": "npx playwright test --config=playwright.config.mvp.ts",
    "test:e2e:headed": "npx playwright test tests/e2e/ --headed",
    "test:e2e:debug": "npx playwright test tests/e2e/ --debug",
    "test:patient": "npx playwright test tests/e2e/patient-journey.spec.ts",
    "test:provider": "npx playwright test tests/e2e/provider-journey.spec.ts",
    "test:supporter": "npx playwright test tests/e2e/supporter-journey.spec.ts",
    "test:crisis": "npx playwright test tests/e2e/crisis-support.spec.ts",
    "test:realtime": "npx playwright test tests/e2e/realtime-communication.spec.ts",
    "test:accessibility": "npx playwright test tests/accessibility/",
    "test:recovery": "npx playwright test tests/accessibility/recovery-features.spec.ts",
    "test:comprehensive": "npx playwright test tests/e2e/ --reporter=html",
    "test:performance": "npx playwright test tests/e2e/ --grep='performance'",
    "test:mobile": "npx playwright test tests/e2e/ --project='Mobile Chrome'",
    "validate:structure": "node scripts/validate-structure.cjs",
    "fix:deployment": "node scripts/fix-deployment.cjs",
    "prebuild": "npm run validate:structure",
    "deployment:check": "node scripts/deployment-check.js",
    "test:storage": "node scripts/test-storage.js",
    "setup:deploy": "node scripts/setup-deploy.js",
    "deploy:vercel": "vercel",
    "deploy:netlify": "netlify deploy",
    "lighthouse:validate": "node scripts/lighthouse-validate.js",
    "lighthouse:test": "node scripts/lighthouse-validate.js --test",
    "lighthouse:local": "node scripts/lighthouse-validate.js --test --url http://localhost:5173",
    "prepare": "husky"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-aspect-ratio": "^1.0.3",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/supabase-js": "^2.54.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.84.2",
    "@tanstack/react-table": "^8.11.8",
    "@types/dompurify": "^3.2.0",
    "@vercel/analytics": "^1.1.1",
    "canvas-confetti": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "embla-carousel-react": "^8.0.0-rc19",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.539.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-day-picker": "^9.8.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "^7.8.0",
    "recharts": "^3.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.0.15",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^20.10.6",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.16",
    "dotenv": "^17.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "lovable-tagger": "^1.0.0",
    "postcss": "^8.4.33",
    "puppeteer": "^24.16.1",
    "tailwindcss": "^3.4.0",
    "terser": "^5.43.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.19"
  }
}
