    "@hookform/resolvers": "^3.3.1",
    "yup": "^1.3.2",
    
    "date-fns": "^2.30.0",
    "react-native-uuid": "^2.0.1",
    
    "react-native-permissions": "^3.8.4",
    "react-native-geolocation-service": "^5.3.1",
    
    "@reduxjs/toolkit": "^1.9.5",
    "react-redux": "^8.1.2",
    "redux-persist": "^6.0.0"
