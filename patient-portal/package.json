    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4",
    "@types/react-native-vector-icons": "^6.4.13",
    "detox": "^20.10.2"
  },
  "jest": {
    "preset": "react-native"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}