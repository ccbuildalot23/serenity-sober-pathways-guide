# API Gateway Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Service Discovery
SERVICE_DISCOVERY_TYPE=consul
CONSUL_HOST=localhost
CONSUL_PORT=8500
SERVICE_NAME=api-gateway
SERVICE_VERSION=1.0.0

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLUSTER_NODES=

# Database Configuration (for analytics and configurations)
DATABASE_URL=postgresql://user:password@localhost:5432/gateway_db
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# API Keys
API_KEY_SALT=your-api-key-salt
API_KEY_HEADER=X-API-Key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# Circuit Breaker
CIRCUIT_BREAKER_TIMEOUT=3000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Monitoring & Observability
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGIN=http://localhost:8080,https://serenity.app
CORS_CREDENTIALS=true

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_DIR=uploads

# Health Check
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# WebSocket
WS_ENABLED=true
WS_PATH=/ws

# GraphQL Federation
GRAPHQL_ENABLED=true
GRAPHQL_PATH=/graphql
GRAPHQL_PLAYGROUND=true

# Security
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
TRUST_PROXY=true

# Service URLs (adjust as needed)
USER_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3002
CHECKIN_SERVICE_URL=http://localhost:3003
CRISIS_SERVICE_URL=http://localhost:3004
CLINICAL_SERVICE_URL=http://localhost:3005
SUPPORT_NETWORK_SERVICE_URL=http://localhost:3006
ANALYTICS_SERVICE_URL=http://localhost:3007
FILES_SERVICE_URL=http://localhost:3008
COMMUNICATION_SERVICE_URL=http://localhost:3009

# Load Balancing
LOAD_BALANCER_STRATEGY=round_robin
HEALTH_CHECK_ENABLED=true
FAILOVER_ENABLED=true

# DDoS Protection
DDOS_BURST=10
DDOS_LIMIT=2
DDOS_MAX_EXPIRY=3600000

# Metrics
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_COLLECTION_INTERVAL=15000