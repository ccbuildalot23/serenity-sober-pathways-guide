# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/serenity_security
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=serenity_security
DATABASE_USER=security_user
DATABASE_PASSWORD=secure_password

# Server Configuration
PORT=3001
NODE_ENV=development
API_VERSION=v1

# Security Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here
API_KEY_SECRET=your-api-key-secret-here
ENCRYPTION_KEY=your-32-character-encryption-key-here
SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# HIPAA Compliance
AUDIT_RETENTION_DAYS=2555
ENABLE_AUDIT_ENCRYPTION=true
AUDIT_LOG_LEVEL=info

# Service Discovery
SERVICE_NAME=security-service
SERVICE_VERSION=1.0.0
HEALTH_CHECK_INTERVAL=30000

# External Services
NOTIFICATION_SERVICE_URL=http://localhost:3003
IDENTITY_SERVICE_URL=http://localhost:3002