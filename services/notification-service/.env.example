# Notification Service Environment Configuration
# Copy to .env and update values for your environment

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_VERSION=v1

# Database Configuration - Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/serenity_db
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT=30000

# Redis Configuration - For queues and caching
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ISSUER=serenity-notification-service
JWT_AUDIENCE=serenity-app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_BURST_REQUESTS=20

# CORS Configuration
CORS_ORIGIN=http://localhost:8080,https://app.serenity.health
CORS_CREDENTIALS=true

# Email Service Configuration
EMAIL_PROVIDER=sendgrid
# SendGrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@serenity.health
SENDGRID_FROM_NAME=Serenity
# Postmark (alternative)
POSTMARK_API_TOKEN=your-postmark-token
POSTMARK_FROM_EMAIL=no-reply@serenity.health

# SMS Configuration - Twilio
TWILIO_ACCOUNT_SID=ACyour-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_PHONE=+1234567890
TWILIO_WEBHOOK_URL=https://api.serenity.health/notifications/v1/webhooks/twilio

# WhatsApp Configuration - Twilio Business API
WHATSAPP_ACCOUNT_SID=ACyour-whatsapp-account-sid
WHATSAPP_AUTH_TOKEN=your-whatsapp-auth-token
WHATSAPP_FROM_PHONE=whatsapp:+1234567890
WHATSAPP_WEBHOOK_URL=https://api.serenity.health/notifications/v1/webhooks/whatsapp

# Push Notifications - Firebase Cloud Messaging
FIREBASE_PROJECT_ID=serenity-notifications
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xyz@serenity-notifications.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Web Push Configuration
WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:support@serenity.health

# Encryption Configuration
ENCRYPTION_KEY=your-32-character-encryption-key-here
ENCRYPTION_ALGORITHM=aes-256-gcm

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-for-verifying-signatures
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_MAX_RETRIES=3

# Monitoring Configuration
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics
HEALTH_CHECK_PATH=/health

# Queue Configuration
QUEUE_CONCURRENCY=10
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_TYPE=exponential
QUEUE_BACKOFF_DELAY=2000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# Security Configuration
HIPAA_AUDIT_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for HIPAA compliance
SECURITY_HEADERS_ENABLED=true
REQUEST_TIMEOUT_MS=30000

# Crisis Management
CRISIS_ESCALATION_TIMEOUT_MINUTES=15
CRISIS_MAX_ESCALATION_LEVELS=3
EMERGENCY_SERVICES_ENABLED=false
EMERGENCY_SERVICES_NUMBER=911

# Templates Configuration
TEMPLATE_CACHE_TTL=300000  # 5 minutes
DEFAULT_TEMPLATE_LANGUAGE=en

# Performance Configuration
CLUSTER_WORKERS=0  # 0 = auto-detect based on CPU cores
GRACEFUL_SHUTDOWN_TIMEOUT=10000

# Development Configuration
DEV_MOCK_SMS=false
DEV_MOCK_EMAIL=false
DEV_MOCK_PUSH=false
DEV_LOG_WEBHOOKS=true

# Testing Configuration
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/serenity_test
TEST_REDIS_URL=redis://localhost:6379/1