{
  "name": "@serenity/notification-service",
  "version": "1.0.0",
  "description": "Notification microservice for Serenity Sober Pathways",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "migrate": "node-pg-migrate",
    "worker": "ts-node src/workers/index.ts",
    "db:migrate": "node-pg-migrate up",
    "db:rollback": "node-pg-migrate down",
    "docker:build": "docker build -t serenity/notification-service .",
    "docker:run": "docker run -p 3000:3000 --env-file .env serenity/notification-service"
  },
  "keywords": ["notifications", "microservice", "healthcare", "hipaa"],
  "author": "Serenity Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^2.0.1",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "bullmq": "^4.15.4",
    "ws": "^8.16.0",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "prom-client": "^15.1.0",
    "@sendgrid/mail": "^8.1.0",
    "postmark": "^4.0.1",
    "twilio": "^4.20.0",
    "firebase-admin": "^12.0.0",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1",
    "axios": "^1.6.5",
    "web-push": "^3.6.6",
    "moment-timezone": "^0.5.44",
    "crypto": "^1.0.1",
    "express-validator": "^7.0.1",
    "express-winston": "^4.2.0",
    "http-status": "^1.7.3",
    "lodash": "^4.17.21",
    "cron-parser": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/ws": "^8.5.10",
    "@types/lodash": "^4.14.202",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.7",
    "@types/web-push": "^3.6.3",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "supertest": "^6.3.3",
    "node-pg-migrate": "^6.2.2",
    "@types/supertest": "^6.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}